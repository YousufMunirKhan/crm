APP_NAME="Switch & Save CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Cold calling: default 1 = run Google discovery in the HTTP request (no worker). Use 0 + queue:work for heavy use.
# COLD_CALLING_RUN_SYNC=1
# Set true only if you run `php artisan queue:work` (otherwise SMS/email/WhatsApp stay "pending").
# COMMUNICATION_QUEUE_ASYNC=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Milliseconds to wait between each bulk marketing email (reduces SMTP 450 “too much mail” from the server IP). Try 2000–5000 if you still see rate limits.
MAIL_BULK_BETWEEN_MESSAGE_DELAY_MS=1200

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI API key (for Today's Report "Generate report" - GPT summary). Only used when enabled for specific users.
OPENAI_API_KEY=

# Anthropic Claude (optional): cold-calling website enrichment second pass after HTML fetch.
# Prefer env here or store key in Settings → Cold calling — never commit real keys.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TIMEOUT=60
# ANTHROPIC_MAX_TOKENS=512

# WhatsApp Cloud (optional fallback): only if Meta App ID/Secret are not stored in CRM Settings → WhatsApp.
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=

# Commission: monthly PDF + emails (runs `commission:send-monthly-reports` on schedule)
# COMMISSION_MONTHLY_REPORT_DAY=1
# COMMISSION_MONTHLY_REPORT_TIME=08:00
# Optional extra addresses (comma-separated) for the admin summary email
# COMMISSION_REPORT_EXTRA_EMAILS=

# --- Integration keys (no defaults; unset means the endpoint returns 503) ---
# Guards /api/pos/* - the desktop POS sends this as the X-Api-Key header.
POS_API_KEY=
# Guards /api/pos-support-messages. The previously committed key is in git
# history and must be treated as compromised - generate a new one.
POS_SUPPORT_API_KEY=
# Guards /api/webhooks/* - sent as X-Webhook-Key, or ?key= for providers that
# can only be given a URL.
WEBHOOK_API_KEY=

# Sanctum token lifetime in minutes (was null = never expired).
SANCTUM_TOKEN_EXPIRATION=720

# Set true to send communications through the queue instead of blocking the
# request. Requires a running queue worker.
COMMUNICATION_QUEUE_ASYNC=false

# Admin seeding. Leave the password blank and the seeder generates one and
# prints it once, rather than shipping a published default.
ADMIN_SEED_EMAIL=admin@switchsave.com
ADMIN_SEED_PASSWORD=
