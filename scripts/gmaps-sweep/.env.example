# Copy to ".env" in this folder. That file is git-ignored - the key stays on this PC.

# Where the CRM is, and the key it expects (COLD_CALLING_SWEEP_KEY in the CRM's own .env).
CRM_URL=https://crm.example.com
CRM_KEY=

# The scraper container from docker-compose.yml.
SCRAPER_URL=http://127.0.0.1:8080

# Seconds to wait between areas. Back-to-back searches from one IP are what gets it rate-limited.
PAUSE_SECONDS=30

# Optional, comma-separated: socks5://user:pass@host:port,http://host2:port2
PROXIES=
